<?xml version="1.0"?>
<package format="3">
  <name>swarm_bringup</name>
  <version>0.1.0</version>
  <description>System-level launch and shared configuration for the UAV swarm stack.</description>
  <maintainer email="jie@example.com">jie</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>formation_controller</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>px4_bridge</exec_depend>
  <exec_depend>px4_bridge_uxrce</exec_depend>
  <exec_depend>swarm_manager</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
